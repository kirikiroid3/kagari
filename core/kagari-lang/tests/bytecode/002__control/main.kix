// Control flow: `if`, `match` with every kind of pattern, `loop` with a value, labelled
// `continue`, `while let`, `for` over a range, an array and a `Vec`, and `?`.

use std::narrative::text::text_style;
use std::screen::size;
use std::system::default_bindings;

enum Shape {
    Dot,
    Line(u32),
    Rect { w: u32, h: u32 },
}

fn area(shape: Shape) -> u32 {
    match shape {
        Shape::Dot => 0,
        Shape::Line(n) if n > 10 => 10,
        Shape::Line(n) => n,
        Shape::Rect { w, h: 0 } => w,
        Shape::Rect { w, h } => w * h,
    }
}

fn classify(pair: (u8, bool)) -> u8 {
    match pair {
        (0, _) | (1, true) => 1,
        (2..=5, false) => 2,
        (n, _) => n,
    }
}

fn loops(limit: u32) -> u32 {
    let mut total: u32 = 0;
    let first = loop {
        total += 1;
        if total > limit {
            break total;
        }
    };
    'outer: for i in 0..=3 {
        for j in [1, 2] {
            if j == i {
                continue 'outer;
            }
            total += j;
        }
    }
    let mut seen = Vec::new();
    seen.push(first);
    seen.push(total);
    for x in seen {
        total += x;
    }
    let mut countdown: Option<u32> = Some(3);
    while let Some(n) = countdown {
        countdown = if n == 0 { None } else { Some(n - 1) };
    }
    total
}

// The left operand is read before the right one assigns it: `y` is copied first.
fn order(x: i32) -> i32 {
    let mut y = x;
    y + {
        y = 5;
        y
    }
}

fn twice_first(values: Vec<u32>) -> Option<u32> {
    let x = values.get(0)?;
    Some(x + x)
}

static TEXT_SPEED: Setting<Duration> = setting(ms(30));
static AUTO_DELAY: Setting<Duration> = setting(ms(1300));
static AUTO_DELAY_PER_CHAR: Setting<Duration> = setting(ms(60));
static SKIP_UNREAD: Setting<bool> = setting(false);
static MASTER: Setting<Volume> = setting(volume(100));
static MUSIC: Setting<Volume> = setting(volume(60));
static SOUND: Setting<Volume> = setting(volume(100));
static VOICE: Setting<Volume> = setting(volume(100));
static VOICE_SUSTAIN: Setting<bool> = setting(false);
static WAIT_FOR_VOICE: Setting<bool> = setting(true);
static WINDOW_OPACITY: Setting<Int<0, 100>> = setting(80);
static FULLSCREEN: Setting<bool> = setting(false);
static ANIMATIONS: Setting<bool> = setting(true);

fn main() -> System {
    // Only functions reachable from `main` or an entry scene are emitted.
    let _ = (area(Shape::Dot), classify((1, true)), loops(3), order(1), twice_first(Vec::new()));
    System {
        title: "Control",
        resolution: size(1280, 720),
        start: Title,
        game: GameView,
        save_slots: 20,
        auto_slots: 3,
        backlog: 200,
        text: text_style(26, WHITE),
        settings: Settings {
            text_speed: TEXT_SPEED,
            auto_delay: AUTO_DELAY,
            auto_delay_per_char: AUTO_DELAY_PER_CHAR,
            skip_unread: SKIP_UNREAD,
            master: MASTER,
            music: MUSIC,
            sound: SOUND,
            voice: VOICE,
            voice_sustain: VOICE_SUSTAIN,
            wait_for_voice: WAIT_FOR_VOICE,
            window_opacity: WINDOW_OPACITY,
            fullscreen: FULLSCREEN,
            animations: ANIMATIONS,
        },
        bindings: default_bindings(),
    }
}

fn Title() -> RootPage {
    RootPage(text!(t!["Title"]))
}

fn GameView(game: Narrative) -> Element {
    game_screen!(game = game)
}
