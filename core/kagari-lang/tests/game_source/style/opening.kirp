// opening.kirp: the representation of the opening step.

fn bounce(level: u8) -> u64 {
    level as u64 * 4 + 2
}

fn render(screen: Screen) -> Screen {
    let mood = DEFAULT_MOOD;
    let height = match mood {
        Mood::Calm | Mood::Sleepy => 0,
        Mood::Excited(0..=2) => 10,
        Mood::Excited(level) => bounce(level),
    };
    let pair = Pair { first: height, second: 20 };
    let swapped = pair.swap();
    let lift = match swapped {
        Pair { first: 0, .. } => swapped.second,
        Pair { first, second } => first + second,
    };
    let ratio: rational = 0.75 * 2.0;
    let title = "Opening" + ": " + "Day 1";
    let shown = title == "Opening" || ratio > 1.5 && !(lift % 2 == 0);
    let frames: u64 = match shown {
        true => 30,
        false => 0,
    };
    let maybe = Some(lift);
    let extra = match maybe {
        Some(value) => value / 2,
        None => 0,
    };
    screen.entity(HANAKO).cord.apply_animation(jump(height + extra - 1));
    screen.entity(AZUSA).appearance.emotion.change(AZUSA::CLOSE_EYE_SMILE).apply_animation(fade(frames));
    screen
}
