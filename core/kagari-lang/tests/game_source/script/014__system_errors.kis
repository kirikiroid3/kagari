<kagari>
  <!-- kis/not-a-root-page: `start` names a dialog, so the mode-graph checks are skipped -->
  <system start="menu">
    <setting-int name="bgm_volume" min="0" max="100" init="50" />
    <setting-enum name="text_speed" type="Speed" init="Slow" />
    <declare-enum name="Speed"><enum name="Slow" repr="0" /><enum name="Fast" repr="1" /></declare-enum>
    <!-- kis/duplicate-setting -->
    <setting-bool name="bgm_volume" init="true" />
    <meta-bool name="cleared" init="false" />
    <!-- kis/duplicate-meta: a setting already has this name -->
    <meta-int name="text_speed" min="0" max="3" init="0" />
    <!-- kis/duplicate-enum: the game declares `Ending` too -->
    <declare-enum name="Ending"><enum name="Good" repr="0" /></declare-enum>
    <save-slots count="6" />

    <sysfn name="dup" />
    <!-- kis/duplicate-sysfn -->
    <sysfn name="dup" />
    <!-- kis/reserved-name -->
    <sysfn name="metafn__mine" />
    <!-- kis/bad-sysfn-type -->
    <sysfn name="ranged" args="int" />
    <!-- kis/unknown-enum -->
    <sysfn name="mystery" args="Nope" />

    <sysfn name="louder" args="i16" return="i16">
      <var-i16 name="step" init="0" />
      <sysfn-arg position="0" var="step" />
      <sysfn-return val="step" />
    </sysfn>
    <sysfn name="noop" />
    <sysfn name="keys" args="Key" />
    <sysfn name="wrong_keys" args="i16" />

    <sysfn name="calls">
      <var-bool name="flag" init="false" />
      <var-char name="small" init="0" />
      <var-vec2 name="arg1" init="0 0" />
      <!-- kis/unknown-sysfn -->
      <sysfn-call name="nowhere" />
      <!-- kis/sysfn-arity -->
      <sysfn-call name="louder" />
      <!-- kis/arg-mismatch: a `bool` for an `i16` -->
      <sysfn-call name="louder"><sysfn-param var="flag" /></sysfn-call>
      <!-- kis/assign-mismatch: an `i16` does not fit in a `char` -->
      <sysfn-call name="louder" save="small"><sysfn-param literal="1" /></sysfn-call>
      <!-- kis/assign-mismatch: `noop` returns nothing -->
      <sysfn-call name="noop" save="small" />
      <!-- kis/var-conflict -->
      <sysfn-call name="louder"><sysfn-param var="small" literal="1" /></sysfn-call>
      <!-- kis/read-only-variable -->
      <set var="cleared" val="true" />
      <!-- kis/not-matchable -->
      <match var="arg1"><cases><case val="_" /><do /></cases></match>
      <!-- kis/var-conflict -->
      <interface-focus-move direction="0 1" target-idx="next" />
      <!-- kis/element-not-allowed -->
      <s>No story here.</s>
    </sysfn>

    <sysfn name="one_arg" args="bool">
      <var-bool name="b" init="false" />
      <!-- kis/value-out-of-range -->
      <sysfn-arg position="3" var="b" />
      <!-- kis/not-a-local -->
      <sysfn-arg position="0" var="bgm_volume" />
    </sysfn>

    <sysfn name="typed" return="bool">
      <!-- kis/return-mismatch -->
      <sysfn-return />
    </sysfn>
    <!-- kis/missing-return -->
    <sysfn name="forgetful" return="bool">
      <metafn-quit />
    </sysfn>

    <sysfn name="ping">
      <!-- kis/sysfn-recursion -->
      <sysfn-call name="pong" />
    </sysfn>
    <sysfn name="pong">
      <sysfn-call name="ping" />
    </sysfn>

    <sysfn name="shadow">
      <!-- kis/local-shadows-global -->
      <var-bool name="cleared" init="false" />
    </sysfn>

    <page name="title" root="true">
      <button on-click="metafn__start(main)">Start</button>
      <!-- kis/unknown-sysfn -->
      <button on-click="nowhere()">Nothing</button>
      <!-- kis/unknown-operation -->
      <button on-click="metafn__push(x)">Push</button>
      <!-- kis/unknown-mode -->
      <button on-click="interface__call(nowhere)">Lost</button>
      <!-- kis/sysfn-arity -->
      <button on-click="louder()">Louder</button>
      <!-- kis/value-out-of-range: there are 6 slots -->
      <button on-click="metafn__save(6)">Save</button>
      <!-- kis/bad-handler -->
      <button on-click="push(save">Broken</button>
      <!-- kis/bad-binding -->
      <button on-click="metafn__revert(3)">Revert</button>
      <!-- kis/not-an-overlay -->
      <button on-click="interface__call(title)">Again</button>
      <!-- kis/not-an-entry -->
      <button on-click="metafn__start(side)">Side</button>
      <!-- kis/unknown-setting: `cleared` is a meta field -->
      <toggle bind="cleared" />
      <!-- kis/bind-mismatch -->
      <slider bind="text_speed" />
      <!-- kis/element-not-allowed -->
      <text-frame />
    </page>

    <!-- kis/handler-signature: an operation -->
    <page name="p1" on-keyboard="metafn__quit()" />
    <!-- kis/handler-signature: arguments are written -->
    <page name="p2" on-keyboard="keys(1)" />
    <!-- kis/handler-signature: `wrong_keys` takes an `i16` -->
    <page name="p3" on-keyboard="wrong_keys()" />
    <!-- kis/bad-value -->
    <dialog name="menu" requires="menu" />
    <!-- kis/bad-value: a root page cannot require a game -->
    <page name="home" root="true" requires="game" />
    <!-- kis/duplicate-mode -->
    <dialog name="p1" />

    <game-mode name="game">
      <!-- kis/non-exhaustive-match -->
      <on-exit>
        <cases>
          <case val="Good" />
          <do>
            <!-- kis/element-not-allowed -->
            <sysfn-arg position="0" var="x" />
          </do>
        </cases>
      </on-exit>
    </game-mode>
  </system>
  <game>
    <declare-enum name="Ending">
      <enum name="Good" repr="0" />
      <enum name="Bad" repr="1" />
    </declare-enum>
    <!-- kis/element-not-allowed -->
    <var-i16 name="counter" init="0" />
    <scene name="main" entry="true">
      <!-- kis/sysfn-call-in-game -->
      <sysfn-call name="noop" />
      <s><m who="">The story.</m></s>
      <return literal="Bad" />
    </scene>
    <scene name="side">
      <s><m who="">Aside.</m></s>
    </scene>
  </game>
</kagari>
