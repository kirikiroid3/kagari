<kagari>
  <system start="title"><page name="title" root="true" /></system>
  <game>
    <import src="../extension/characters.kix" />
    <import src="../extension/presets.kix" />
    <import src="std/system-ctx.kix" />

    <declare-enum name="Ending">
      <enum name="Normal" repr="0" />
    </declare-enum>

    <scene name="opening" entry="true">
      <s>
        <represent src="../style/opening.kirp" />
        The opening begins.
      </s>
      <s>
        <r>screen.hud().text_frame.set(Visibility::Hidden);</r>
        The text frame fades away.
      </s>
      <s><m who="Azusa" voice="AZUSA_0072">ぬっ</m></s>
      <s><m who="">……</m></s>
      <s>
        <r><![CDATA[
          let wide: u64 = 3;
          let tall = wide < 4 && wide > 0;
          screen.background().change(BG::ROOF).apply_animation(fade(30));
        ]]></r>
        On the roof.
      </s>
      <return literal="Normal" />
    </scene>
  </game>
</kagari>
