<kagari>
  <system start="title"><page name="title" root="true" /></system>
  <game>
    <include src="include/missing.kis" />
    <include src="include/cycle_a.kis" />
    <include src="include/system_root.kis" />
    <import src="std/ui.kix" />
    <import src="x.kis" />

    <declare-enum name="Ending">
      <enum name="Normal" repr="0" />
    </declare-enum>

    <scene name="main" entry="true">
      <s>Hello.</s>
      <call scene="from_cycle_a" />
      <call scene="from_cycle_b" />
      <return literal="Normal" />
    </scene>
  </game>
</kagari>
