<kagari>
  <system start="title"><page name="title" root="true" /></system>
  <game>
    <declare-enum name="Ending">
      <enum name="Normal" repr="0" />
    </declare-enum>

    <declare-enum name="Route">
      <enum name="None" repr="0" />
      <enum name="Hanako" repr="1" />
      <!-- kis/duplicate-variant -->
      <enum name="Hanako" repr="2" />
      <!-- kis/duplicate-repr -->
      <enum name="Azusa" repr="1" />
    </declare-enum>

    <var-enum name="route" type="Route" init="None" />
    <var-bool name="met_azusa" init="false" />
    <!-- kis/bad-value -->
    <var-bool name="flag" init="maybe" />
    <!-- kis/value-out-of-range -->
    <var-int name="affection" min="0" max="5" init="9" />
    <!-- kis/bad-range -->
    <var-int name="backwards" min="5" max="0" init="0" />

    <scene name="main" entry="true">
      <!-- kis/local-shadows-global -->
      <var-bool name="met_azusa" init="true" />

      <!-- kis/unknown-attribute (warning) -->
      <s mood="happy">It was the last day of summer.</s>
      <!-- kis/element-not-allowed -->
      <s>Outer text <s>inner step</s></s>
      <!-- kis/unknown-element (warning) -->
      <foo />

      <!-- kis/bad-name -->
      <label id="1abc" />
      <label id="top" />
      <!-- kis/duplicate-label -->
      <label id="top" />

      <choice id="pick">
        <choice-arm id="a" text="A">
          <label id="in_a" />
          <s>In A.</s>
        </choice-arm>
        <choice-arm id="b" text="B">
          <!-- kis/label-out-of-scope -->
          <goto label="in_a" />
        </choice-arm>
        <!-- kis/duplicate-arm-id -->
        <choice-arm id="a" text="A again" />
      </choice>
      <!-- kis/duplicate-choice-id -->
      <choice id="pick">
        <choice-arm id="only" text="Only" />
      </choice>
      <!-- kis/missing-attribute -->
      <choice>
        <choice-arm id="only" text="Only" />
      </choice>

      <!-- kis/unknown-scene -->
      <call scene="nowhere" />
      <!-- kis/unknown-label -->
      <goto label="nowhere" />
      <!-- kis/unknown-variable -->
      <set var="unknown_var" val="true" />
      <!-- kis/not-a-counter -->
      <add var="met_azusa" val="1" />

      <!-- kis/var-conflict -->
      <match var="met_azusa" vars="met_azusa route">
        <cases>
          <case val="_" />
          <do />
        </cases>
      </match>
      <!-- kis/pattern-arity -->
      <match vars="met_azusa route">
        <cases>
          <case val="true" />
          <do />
        </cases>
        <cases>
          <case val="_ _" />
          <do />
        </cases>
      </match>
      <s>The end.</s>
      <return literal="Normal" />
    </scene>

    <!-- kis/duplicate-scene -->
    <scene name="main">
      <s>Another main.</s>
    </scene>
  </game>
</kagari>
