<kagari>
  <system start="title" />
  <game>
    <declare-enum name="Ending">
      <enum name="Normal" repr="0" />
      <enum name="Azusa"  repr="1" />
    </declare-enum>
    <declare-enum name="Answer">
      <enum name="Accepted" repr="0" />
      <enum name="Rejected" repr="1" />
    </declare-enum>

    <var-enum name="answer" type="Answer" init="Rejected" />
    <var-bool name="won" init="false" />
    <var-char name="score" init="0" />

    <scene name="main" entry="true">
      <var-enum name="local_answer" type="Answer" init="Rejected" />
      <!-- ok: assign to a global and to a local -->
      <call scene="confession" assign="answer" />
      <call scene="confession" assign="local_answer" />
      <!-- ok: the returned value may be dropped -->
      <call scene="confession" />
      <call scene="qte" assign="won" />
      <call scene="count" assign="score" />
      <!-- kis/assign-mismatch: `talk` returns no value -->
      <call scene="talk" assign="won" />
      <!-- kis/assign-mismatch: `qte` returns `bool` -->
      <call scene="qte" assign="answer" />
      <!-- kis/unknown-variable -->
      <call scene="qte" assign="nothing" />
      <match var="answer">
        <cases>
          <case val="Accepted" />
          <do>
            <return literal="Azusa" />
          </do>
        </cases>
        <cases>
          <case val="Rejected" />
          <do />
        </cases>
      </match>
      <return literal="Normal" />
    </scene>

    <!-- ok: every arm of the choice returns -->
    <scene name="confession" returns="Answer">
      <choice id="confess">
        <choice-arm id="yes" text="Tell her">
          <return literal="Accepted" />
        </choice-arm>
        <choice-arm id="no" text="Say nothing">
          <return literal="Rejected" />
        </choice-arm>
      </choice>
    </scene>

    <!-- ok: returns a local; the `<goto>` loop leaves only by `<return>` -->
    <scene name="qte" returns="bool">
      <var-bool name="qte_success" init="false" />
      <label id="again" />
      <choice id="press">
        <choice-arm id="now" text="Press">
          <set var="qte_success" val="true" />
          <return var="qte_success" />
        </choice-arm>
        <choice-arm id="miss" text="Wait">
          <return literal="false" />
        </choice-arm>
        <choice-arm id="retry" text="Retry">
          <goto label="again" />
        </choice-arm>
      </choice>
    </scene>

    <scene name="count" returns="char">
      <s>Counting.</s>
      <return literal="3" />
    </scene>

    <scene name="talk">
      <s>Hello.</s>
      <!-- ok: a bare `<return>` in a scene without a value -->
      <return />
    </scene>

    <!-- kis/missing-return: the `false` arm reaches the end -->
    <scene name="half" returns="bool">
      <s>Half.</s>
      <match var="won">
        <cases>
          <case val="true" />
          <do>
            <return literal="true" />
          </do>
        </cases>
        <cases>
          <case val="false" />
          <do />
        </cases>
      </match>
    </scene>

    <!-- kis/missing-return: an empty scene -->
    <scene name="empty" returns="bool" />

    <scene name="errors" returns="Answer">
      <var-bool name="local_flag" init="false" />
      <!-- kis/var-conflict -->
      <return var="local_flag" literal="Accepted" />
      <!-- kis/return-mismatch: no value -->
      <return />
      <!-- kis/return-mismatch: `local_flag` is a bool -->
      <return var="local_flag" />
      <!-- kis/return-not-local -->
      <return var="answer" />
      <!-- kis/unknown-variable -->
      <return var="nothing" />
      <!-- kis/bad-value -->
      <return literal="Maybe" />
    </scene>

    <scene name="void_errors">
      <!-- kis/return-mismatch: this scene returns no value -->
      <return literal="true" />
    </scene>

    <!-- kis/bad-returns -->
    <scene name="int_scene" returns="int">
      <return literal="1" />
    </scene>

    <!-- kis/unknown-enum -->
    <scene name="unknown_type" returns="Mood">
      <return literal="Happy" />
    </scene>

    <!-- kis/value-out-of-range -->
    <scene name="too_big" returns="char">
      <return literal="300" />
    </scene>
  </game>
</kagari>
