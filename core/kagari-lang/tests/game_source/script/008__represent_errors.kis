<kagari>
  <system start="title"><page name="title" root="true" /></system>
  <game>
    <import src="../extension/characters.kix" />
    <import src="../extension/bad.kix" />

    <declare-enum name="Ending">
      <enum name="Normal" repr="0" />
    </declare-enum>

    <scene name="broken" entry="true">
      <s><represent src="../style/bad_signature.kirp" />Wrong signature.</s>
      <s><represent src="../style/no_render.kirp" />No render.</s>
      <s><r>screen.entity(HANAKO).cord.apply_animation(jump(true));</r>Mismatch.</s>
      <s><r>screen.fly();</r>No method.</s>
      <s><r>let wings = screen.entity(HANAKO).wings;</r>No field.</s>
      <s><r>let height: u64 = match true { true => 1 };</r>Non-exhaustive.</s>
      <s><r>let x = 5;</r>Cannot infer.</s>
      <s><r>screen.background().change(BG::ROOF);</r>Unapplied.</s>
      <s><r>let hidden = Hidden;</r>Unresolved.</s>
      <s><m who="Hanako" voice="HANAKO">Hi.</m></s>
      <return literal="Normal" />
    </scene>
  </game>
</kagari>
