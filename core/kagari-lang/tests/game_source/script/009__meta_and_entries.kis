<kagari>
  <system start="title">
    <meta-bool name="cleared_azusa" init="false" />
    <meta-enum name="last_route" type="Route" init="None" />
  </system>
  <game>
    <!-- kis/bad-entry-exit: `cleared` is a bool -->
    <entry name="main" scene="main" exit="cleared" />

    <var-bool name="cleared" init="false" from-meta="cleared_azusa" />
    <!-- kis/meta-type-mismatch -->
    <var-char name="cleared_count" init="0" from-meta="cleared_azusa" />

    <scene name="main">
      <s>The end.</s>
      <meta-set var="cleared_azusa" val="true" />
      <!-- kis/meta-enum-unsupported -->
      <meta-set var="last_route" val="None" />
      <!-- kis/unknown-meta -->
      <meta-set var="no_such_meta" val="true" />
    </scene>

    <declare-enum name="Ending">
      <enum name="Uninitialized" repr="0" />
      <enum name="Good"          repr="1" />
    </declare-enum>

    <!-- A local of the entry scene is visible to `exit`. -->
    <entry name="after_story" scene="after_story" exit="ending" />
    <scene name="after_story">
      <var-enum name="ending" type="Ending" init="Uninitialized" />
      <s>Afterwards.</s>
      <set var="ending" val="Good" />
    </scene>

    <!-- kis/bad-entry-exit: `ending` is local to another scene -->
    <entry name="epilogue" scene="epilogue" exit="ending" />
    <scene name="epilogue">
      <s>Later.</s>
    </scene>
  </game>
</kagari>
