<kagari>
  <system start="title">
    <meta-bool name="cleared_azusa" init="false" />
    <meta-enum name="last_route" type="Route" init="None" />
  </system>
  <game>
    <var-bool name="cleared" init="false" from-meta="cleared_azusa" />
    <!-- kis/meta-type-mismatch -->
    <var-char name="cleared_count" init="0" from-meta="cleared_azusa" />

    <!-- An entry scene returns `Ending` without saying so. -->
    <scene name="main" entry="true">
      <s>The end.</s>
      <meta-set var="cleared_azusa" val="true" />
      <!-- kis/meta-enum-unsupported -->
      <meta-set var="last_route" val="None" />
      <!-- kis/unknown-meta -->
      <meta-set var="no_such_meta" val="true" />
      <return literal="Good" />
    </scene>

    <!-- `Ending` may be declared after the scenes that return it. -->
    <declare-enum name="Ending">
      <enum name="Good" repr="0" />
      <enum name="Bad"  repr="1" />
    </declare-enum>

    <!-- Writing `returns="Ending"` is allowed; a local can carry the ending. -->
    <scene name="after_story" returns="Ending" entry="true">
      <var-enum name="ending" type="Ending" init="Bad" />
      <s>Afterwards.</s>
      <set var="ending" val="Good" />
      <return var="ending" />
    </scene>

    <!-- kis/entry-returns: an entry scene cannot return `bool` -->
    <scene name="epilogue" returns="bool" entry="true">
      <s>Later.</s>
      <return literal="true" />
    </scene>

    <!-- `entry="false"` is the same as no `entry`. -->
    <scene name="side" entry="false">
      <s>Aside.</s>
    </scene>

    <!-- kis/bad-value: `entry` is a bool -->
    <scene name="maybe" entry="sometimes">
      <s>Perhaps.</s>
    </scene>
  </game>
</kagari>
