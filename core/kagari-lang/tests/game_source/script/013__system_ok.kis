<kagari>
  <system start="title">
    <!-- `Speed` is declared after its first use. -->
    <setting-int name="bgm_volume" min="0" max="100" init="80" />
    <setting-bool name="skip_unread" init="false" />
    <setting-enum name="text_speed" type="Speed" init="Normal" />
    <declare-enum name="Speed">
      <enum name="Slow" repr="0" />
      <enum name="Normal" repr="1" />
      <enum name="Fast" repr="2" />
    </declare-enum>

    <meta-bool name="cleared" init="false" />
    <!-- A meta field may have a game enum type. -->
    <meta-enum name="last_route" type="Route" init="None" />

    <save-slots count="6" />

    <sysfn name="louder" args="i16" return="i16">
      <var-i16 name="step" init="0" />
      <sysfn-arg position="0" var="step" />
      <add var="bgm_volume" val="10" />
      <sysfn-return val="step" />
    </sysfn>

    <sysfn name="quick_save">
      <metafn-save param="0" />
    </sysfn>

    <sysfn name="title_keys" args="Key">
      <var-enum name="key" type="Key" init="Enter" />
      <sysfn-arg position="0" var="key" />
      <match var="key">
        <cases>
          <case val="Tab" />
          <do><interface-focus-move target-idx="next" /></do>
        </cases>
        <cases>
          <case val="Up" />
          <do><interface-focus-move target-idx="prev" /></do>
        </cases>
        <cases>
          <case val="Enter" />
          <do><interface-focus-activate /></do>
        </cases>
        <cases>
          <case val="_" />
          <do />
        </cases>
      </match>
    </sysfn>

    <sysfn name="page_keys" args="Key">
      <var-enum name="key" type="Key" init="Enter" />
      <sysfn-arg position="0" var="key" />
      <match var="key">
        <cases>
          <case val="Escape" />
          <do><interface-return /></do>
        </cases>
        <cases>
          <case val="Tab" />
          <do><interface-focus-move target-idx="next" /></do>
        </cases>
        <cases>
          <case val="Digit2" />
          <do><interface-focus-move target-idx="2" /></do>
        </cases>
        <cases>
          <case val="Enter" />
          <do><interface-focus-activate /></do>
        </cases>
        <cases>
          <case val="_" />
          <do />
        </cases>
      </match>
    </sysfn>

    <sysfn name="page_pad" args="vec2 PadButton">
      <var-vec2 name="arg1" init="0 0" />
      <var-enum name="button" type="PadButton" init="None" />
      <sysfn-arg position="0" var="arg1" />
      <sysfn-arg position="1" var="button" />
      <match var="button">
        <cases>
          <case val="None" />
          <do><interface-focus-move direction="arg1" /></do>
        </cases>
        <cases>
          <case val="South" />
          <do><interface-focus-activate /></do>
        </cases>
        <cases>
          <case val="East" />
          <do><interface-return /></do>
        </cases>
        <cases>
          <case val="_" />
          <do />
        </cases>
      </match>
    </sysfn>

    <sysfn name="game_keys" args="Key">
      <var-enum name="key" type="Key" init="Enter" />
      <var-i16 name="v" init="0" />
      <sysfn-arg position="0" var="key" />
      <match var="key">
        <cases>
          <case val="Enter" />
          <case val="Space" />
          <do><metafn-advance /></do>
        </cases>
        <cases>
          <case val="Digit1" />
          <do><metafn-select param="0" /></do>
        </cases>
        <cases>
          <case val="F5" />
          <do><sysfn-call name="quick_save" /></do>
        </cases>
        <cases>
          <case val="Up" />
          <do>
            <!-- `int 0..=100` widens to `i16`. -->
            <sysfn-call name="louder" save="v"><sysfn-param var="bgm_volume" /></sysfn-call>
          </do>
        </cases>
        <cases>
          <case val="Escape" />
          <do><interface-call page="menu" /></do>
        </cases>
        <cases>
          <case val="_" />
          <do />
        </cases>
      </match>
    </sysfn>

    <sysfn name="game_pad" args="vec2 PadButton">
      <var-enum name="button" type="PadButton" init="None" />
      <sysfn-arg position="1" var="button" />
      <match var="button">
        <cases>
          <case val="South" />
          <do><metafn-advance /></do>
        </cases>
        <cases>
          <case val="Start" />
          <do><interface-call page="menu" /></do>
        </cases>
        <cases>
          <case val="_" />
          <do />
        </cases>
      </match>
    </sysfn>

    <page name="title" root="true" on-keyboard="title_keys()">
      <col style="menu">
        <button on-click="metafn__start(main)">Start</button>
        <button on-click="interface__call(load)">Load</button>
        <button on-click="interface__call(config)">Config</button>
        <button on-click="metafn__quit()">Quit</button>
      </col>
    </page>

    <page name="credits" root="true">
      <button on-click="interface__goto(title)">Back to title</button>
    </page>

    <page name="config" on-keyboard="page_keys()" on-controller="page_pad()">
      <layer name="main" style="panel">
        <slider bind="bgm_volume" />
        <toggle bind="skip_unread" />
        <select bind="text_speed" />
        <button on-click="louder(5)">Louder</button>
        <button on-click="interface__return()">Back</button>
      </layer>
    </page>

    <page name="load" on-keyboard="page_keys()">
      <for-slots>
        <button on-click="metafn__load(slot.index)">Load</button>
      </for-slots>
      <button on-click="interface__return()">Back</button>
    </page>

    <page name="save" requires="game" on-keyboard="page_keys()">
      <for-slots>
        <button on-click="metafn__save(slot.index)">Save</button>
      </for-slots>
      <button on-click="interface__return()">Back</button>
    </page>

    <page name="backlog" requires="game" on-keyboard="page_keys()">
      <for-history>
        <row>
          <backlog-line />
          <button on-click="metafn__play_voice(entry.voice)">Voice</button>
          <button on-click="metafn__revert(entry.index)">Jump</button>
        </row>
      </for-history>
      <button on-click="interface__return()">Back</button>
    </page>

    <dialog name="menu" requires="game" on-keyboard="page_keys()">
      <button on-click="interface__call(save)">Save</button>
      <button on-click="interface__call(backlog)">Backlog</button>
      <button on-click="interface__goto(title)">Title</button>
      <button on-click="interface__focus_move(next)">Next</button>
      <button on-click="interface__return()">Close</button>
    </dialog>

    <game-mode name="game" on-keyboard="game_keys()" on-controller="game_pad()">
      <game-screen />
      <layer name="text" style="message">
        <text-frame on-click="metafn__advance()" />
        <for-choices>
          <button on-click="metafn__select(choice.index)">Choose</button>
        </for-choices>
      </layer>
      <layer name="quick" style="quick-menu">
        <button on-click="quick_save()">Q.Save</button>
        <button on-click="interface__call(menu)">Menu</button>
      </layer>
      <on-exit>
        <cases>
          <case val="Good" />
          <do>
            <meta-set var="cleared" val="true" />
            <meta-set var="last_route" val="Azusa" />
            <interface-goto page="credits" />
          </do>
        </cases>
        <cases>
          <case val="_" />
          <do />
        </cases>
      </on-exit>
    </game-mode>
  </system>
  <game>
    <declare-enum name="Ending">
      <enum name="Good" repr="0" />
      <enum name="Bad" repr="1" />
    </declare-enum>
    <declare-enum name="Route">
      <enum name="None" repr="0" />
      <enum name="Azusa" repr="1" />
    </declare-enum>
    <scene name="main" entry="true">
      <s><m who="">The story.</m></s>
      <return literal="Good" />
    </scene>
  </game>
</kagari>
