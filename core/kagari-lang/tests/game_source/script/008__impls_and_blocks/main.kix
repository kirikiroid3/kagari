struct Square<const N: u64> {
    side: u64,
}

type Board = Square<8>;
type Said = Say::Output;

impl<const N: u64> Square<N> {
    const CELLS: u64 = N * N;

    fn new() -> Self {
        Self { side: N }
    }

    fn cells(&self) -> u64 {
        self.side * Self::CELLS
    }

    fn span(&self) -> Range<u64> {
        Range { start: 0, end: self.cells(), inclusive: false }
    }
}

fn same<T: Eq>(a: T, b: T) -> bool {
    a == b
}

fn widen<T: Integer>(value: T) -> u64 {
    Integer::into(value)
}

fn run<S: std::narrative::Step>(step: S) -> S::Output {
    push_step(step)
}

fn uses() -> u64 {
    let board = Board::new();
    let level: Int<0, 5> = 3;
    const LOCAL: u64 = 2;
    fn helper(x: u64) -> u64 {
        x + LOCAL
    }
    use crate::widen as w;
    {
        fn inner() -> u64 {
            helper(1)
        }
        inner() + board.cells() + w(level)
    }
}

impl bool {}
