// presets.kix: studio presets used by the opening.

enum Mood {
    Calm,
    Excited(u8),
    Sleepy,
}

struct Pair<T> {
    first: T,
    second: T,
}

impl<T> Pair<T> {
    fn swap(self) -> Pair<T> {
        Pair { first: self.second, second: self.first }
    }
}

impl Mood {
    fn intensity(self) -> u8 {
        match self {
            Mood::Calm => 0,
            Mood::Excited(level) => level,
            Mood::Sleepy => 1,
        }
    }
}

#[must_use]
struct Pending {
    frames: u64,
}

impl Pending {
    fn commit(self) -> u64 {
        self.frames
    }
}

const DEFAULT_MOOD: Mood = Mood::Excited(3);

import CG_001 from "cg_001.png" as ImageAsset;
import AZUSA_0072 from "voice/azusa_0072.ogg" as VoiceAsset;
