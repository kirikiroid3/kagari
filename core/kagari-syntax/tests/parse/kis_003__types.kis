static SPEED: Setting<Int<0, 10>> = setting(5);
const SIGNED: Int<-3, {N}> = 0;
type Array = [T; 4];
type Ref = &mut T;
type Shared = &T;
type Pair = (A, B);
type Single = (A,);
type Paren = (A);
type Unit = ();
type Infer = Vec<_>;
type Qualified = std::screen::Screen;
type Assoc = Self::Output;
type F1 = fn(u8) -> u8;
type F2 = const fn(Screen) -> Screen;
type F3 = pushdown fn();
type F4 = scene fn(u8, bool) -> Ending;
type C1 = Fn() -> u8;
type C2 = const Fn(u8);
type C3 = pushdown Fn(u8, u8) -> (u8, u8);
type Nested = Vec<Vec<Vec<u8>>>;
type Higher = fn(fn() -> u8) -> Fn(u8);
