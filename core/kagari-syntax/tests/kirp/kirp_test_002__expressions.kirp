/* outer /* nested */ still a comment */

// A helper function.
fn helper(x: u64) -> u64 {
    x * 2 + 1
}

fn render(screen: Screen) -> Screen {
    let a: u64 = 1;
    let b = 2;
    let c = 3;
    let d = 4;
    let e = false;
    let ok = a + b * c == d && !e;
    let mixed = a - b - c / d % 2 > 0 || e;
    let cast = -(a as i64) * b as i64;
    let ratio = 0.75;
    let name = "Hanako\n\u{3042}\t\"quoted\"\\";
    let greeting = name + " desu";
    let none = Option::<u64>::None;
    let anim = CordAnimation { height: 20, ..jump::<u64>(3) };
    let short = CordAnimation { height: a, frames: b, };
    let size = match ok {
        true => 1,
        false => 0,
    };
    let label = match anim {
        CordAnimation { height: 0, .. } => "flat",
        CordAnimation { height: 1..=10 | 20, frames } => "low",
        _ => "high",
    };
    let picked = match none {
        Some(-3..=-1) => 1,
        Option::Some(0 | 1) => { 2 }
        Some(n) => n,
        Option::None => 0,
    };
    let shown = match Visibility::Shown {
        Visibility::Hidden => false,
        Visibility::Shown => true,
    };
    let unit = ();
    screen.entity(HANAKO).cord.apply_animation(jump(helper(size)));
    screen
}
