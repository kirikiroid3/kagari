//! The Kagari standard library root.

pub mod prelude;
pub mod time;
pub mod screen;
pub mod stage;
pub mod narrative;
pub mod ui;
pub mod system;
pub mod shaders;

/// A runtime string, built by `fn` code.
#[builtin]
pub struct String;
/// A growable list; out-of-range writes are evaluation errors.
#[builtin]
pub struct Vec<T>;
/// An exact rational number.
#[builtin]
pub struct Rat;
impl Rat {
    /// `num / den` in lowest terms; `den == 0` is a division by zero.
    #[builtin]
    pub const fn new(num: i128, den: i128) -> Rat;
    /// This value as a `Decimal`: the integer part and at most 7 digits after the point,
    /// truncated toward zero.
    #[builtin]
    pub const fn to_decimal(self) -> Decimal;
}
/// An exact decimal number, written `0.5`: the exact replacement for floats.
#[builtin]
pub struct Decimal;
impl Decimal {
    /// `value` as a `Decimal`, exactly: every integer fits.
    #[builtin]
    pub const fn from_int<I: Integer>(value: I) -> Decimal;
}

/// `start..end` (`inclusive` false) or `start..=end` (`inclusive` true).
pub struct Range<T> {
    pub start: T,
    pub end: T,
    pub inclusive: bool,
}

impl<T> Vec<T> {
    /// An empty list.
    #[builtin]
    pub const fn new() -> Vec<T>;
    /// The number of elements.
    #[builtin]
    pub const fn len(&self) -> usize;
    /// Whether the list has no elements.
    #[builtin]
    pub const fn is_empty(&self) -> bool;
    /// The element at `index`, or `None` when out of range.
    #[builtin]
    pub const fn get(&self, index: usize) -> Option<T>;
    /// Replaces the element at `index`; out of range is an evaluation error.
    #[builtin]
    pub const fn set(&mut self, index: usize, value: T);
    /// Appends `value` at the end.
    #[builtin]
    pub const fn push(&mut self, value: T);
}

/// An optional value.
pub enum Option<T> {
    None,
    Some(T),
}

/// A success value or an error value.
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

/// Types with structural equality. Automatic for structs and enums whose fields are all `Eq`.
#[builtin]
pub trait Eq {}
impl Eq for String {}
impl<T: Eq> Eq for Vec<T> {}
impl Eq for Rat {}
impl Eq for Decimal {}
impl Eq for ImageAsset {}
impl Eq for AudioAsset {}
impl Eq for VoiceAsset {}
impl Eq for VideoAsset {}
impl Eq for FontAsset {}
impl Eq for ShaderAsset {}
impl Eq for narrative::Text {}
impl Eq for screen::Screen {}

/// The integer types: `Int<lo, hi>` and Rust's integers.
#[builtin]
pub trait Integer {
    /// This value as `T`; a compile error unless every value of `Self` fits in `T`.
    const fn into<T: FromInteger>(self) -> T;
    /// This value clamped to the range of `T`.
    const fn saturate<T: Integer>(self) -> T;
}
impl Integer for u8 {}
impl Integer for u16 {}
impl Integer for u32 {}
impl Integer for u64 {}
impl Integer for u128 {}
impl Integer for i8 {}
impl Integer for i16 {}
impl Integer for i32 {}
impl Integer for i64 {}
impl Integer for i128 {}
impl Integer for usize {}
impl Integer for isize {}
impl<const LO: i64, const HI: i64> Integer for Int<LO, HI> {}

/// The types an integer converts to with `Integer::into`: every `Integer` type (implicitly, so
/// a parameter bounded by `Integer` is one too) and `Decimal`.
#[builtin]
pub trait FromInteger {}
impl FromInteger for Decimal {}

/// Types a story can draw at random: fieldless enums and `Int<lo, hi>`.
#[builtin]
pub trait RandChoose {}
impl<const LO: i64, const HI: i64> RandChoose for Int<LO, HI> {}

/// Types whose values are exactly the asset constants of the program.
#[builtin]
pub trait Asset {}

/// An image file: PNG, JPEG or WebP.
#[builtin]
pub struct ImageAsset;
/// A music or sound file.
#[builtin]
pub struct AudioAsset;
/// A voice file, bound to a line.
#[builtin]
pub struct VoiceAsset;
/// A movie file.
#[builtin]
pub struct VideoAsset;
/// A font file.
#[builtin]
pub struct FontAsset;
/// The identity of a shader file of any role; effect values hold it.
#[builtin]
pub struct ShaderAsset;
impl Asset for ImageAsset {}
impl Asset for AudioAsset {}
impl Asset for VoiceAsset {}
impl Asset for VideoAsset {}
impl Asset for FontAsset {}

/// Loads the asset at `path`, a string literal relative to the program's asset directory.
#[builtin]
pub const fn asset<A: Asset>(path: narrative::Text) -> A;
/// The font file at `path` in the system font directories, a string literal relative to one of
/// them: `"msgothic.ttc"` in `C:\Windows\Fonts`, `"truetype/dejavu/DejaVuSans.ttf"` in
/// `/usr/share/fonts`. The directories are searched in order and the first file found wins.
/// `kagari build` packs the file with the other assets; `[assets] system-fonts = false` in
/// `kagari.toml` forbids system fonts.
#[builtin]
pub const fn system_font(path: narrative::Text) -> FontAsset;
