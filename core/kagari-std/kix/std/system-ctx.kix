// std/system-ctx.kix: game scope only. Tentative names from the STD book.

struct SystemContext;

struct Setting<T>;

impl SystemContext {
    #[builtin]
    fn voice_volume(self) -> Setting<u64>;
}

enum Visibility {
    Shown,
    Hidden,
}

impl Visibility {
    #[builtin]
    fn set(self, value: Visibility);
}

struct Hud {
    text_frame: Visibility,
    quick_menu: Visibility,
}

impl Screen {
    #[builtin]
    fn hud(self) -> Hud;
}
