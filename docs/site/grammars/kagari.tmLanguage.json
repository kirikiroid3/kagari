        },
        {
          "match": "(?<!\\.)(\\.)\\s*([_\\p{L}][_\\p{L}\\p{N}\\p{Mn}\\p{Mc}]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.kagari"
            },
            "2": {
              "name": "variable.other.property.kagari"
            }
          }
