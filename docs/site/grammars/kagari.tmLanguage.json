        {
          "name": "storage.modifier.static.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:static)(?![_\\p{L}\\p{N}])"
        },
        {
          "comment": "`pushdown` is a keyword only before `fn` or `Fn(`.",
          "name": "storage.modifier.pushdown.kagari",
          "match": "(?<![_\\p{L}\\p{N}])pushdown(?=\\s+(?:fn(?![_\\p{L}\\p{N}])|Fn\\s*\\())"
        },
        {
          "comment": "`scene` is a keyword only before `fn`.",
          "name": "storage.modifier.scene.kagari",
          "match": "(?<![_\\p{L}\\p{N}])scene(?=\\s+fn(?![_\\p{L}\\p{N}]))"
        },
        {
          "name": "constant.language.boolean.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:true|false)(?![_\\p{L}\\p{N}])"
        },
        {
          "name": "variable.language.self.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:self)(?![_\\p{L}\\p{N}])"
        },
        {
          "name": "support.type.self.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:Self)(?![_\\p{L}\\p{N}])"
        },
        {
          "comment": "`Fn` before `(` is a closure type.",
          "name": "entity.name.type.closure.kagari",
          "match": "(?<![_\\p{L}\\p{N}])Fn(?=\\s*\\()"
        }
