    },
    "types-builtin": {
      "name": "support.type.primitive.kagari",
      "match": "(?<![_\\p{L}\\p{N}])(?:u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|usize|isize|bool)(?![_\\p{L}\\p{N}])"
    },
    "member-access": {
      "patterns": [
        {
          "comment": "Method call `.name(` or `.name::<…>(`.",
          "match": "(?<!\\.)(\\.)\\s*([_\\p{L}][_\\p{L}\\p{N}\\p{Mn}\\p{Mc}]*)(?=\\s*(?:\\(|::\\s*<))",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.kagari"
