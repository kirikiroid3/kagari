        {
          "comment": "Generic function `name::<…>`.",
          "name": "entity.name.function.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?!\\p{Lu})[_\\p{L}][_\\p{L}\\p{N}\\p{Mn}\\p{Mc}]*(?=\\s*::\\s*<)"
        },
        {
          "name": "entity.name.function.kagari",
          "match": "(?<![_\\p{L}\\p{N}])[_\\p{L}][_\\p{L}\\p{N}\\p{Mn}\\p{Mc}]*(?=\\()"
        }
      ]
    },
    "constants": {
      "name": "constant.other.caps.kagari",
      "match": "(?<![_\\p{L}\\p{N}])[A-Z][A-Z0-9_]+(?![_\\p{L}\\p{N}])"
    },
    "paths": {
      "name": "entity.name.namespace.kagari",
      "match": "(?<![_\\p{L}\\p{N}])(?!\\p{Lu})[_\\p{L}][_\\p{L}\\p{N}\\p{Mn}\\p{Mc}]*(?=\\s*::)"
    },
    "types": {
      "name": "entity.name.type.kagari",
      "match": "(?<![_\\p{L}\\p{N}])\\p{Lu}[_\\p{L}\\p{N}\\p{Mn}\\p{Mc}]*"
