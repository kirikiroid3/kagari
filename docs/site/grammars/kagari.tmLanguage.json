          "name": "keyword.control.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:if|else|match|loop|while|for|in|break|continue|return)(?![_\\p{L}\\p{N}])"
        },
        {
          "name": "keyword.other.let.kagari",
