        {
          "name": "storage.type.function.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:fn)(?![_\\p{L}\\p{N}])"
        },
        {
          "name": "storage.type.struct.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:struct)(?![_\\p{L}\\p{N}])"
        },
        {
          "name": "storage.type.enum.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:enum)(?![_\\p{L}\\p{N}])"
        },
        {
          "name": "storage.type.trait.kagari",
          "match": "(?<![_\\p{L}\\p{N}])(?:trait)(?![_\\p{L}\\p{N}])"
